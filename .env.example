# ─────────────────────────────────────────────────────────────
#  J.A.R.V.I.S. configuration — copy to ".env" and fill in.
# ─────────────────────────────────────────────────────────────

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Passcode required to open the dashboard (desktop & phone).
# Pick something long — JARVIS can read and send your email.
JARVIS_ACCESS_CODE=change-me-to-something-long

# Main brain. "gemini-flash-latest" always points to Google's newest Flash model.
# Other good options: gemini-pro-latest (smarter, slower, pricier), or a pinned id.
GEMINI_MODEL=gemini-flash-latest

# Fast model used to transcribe your voice.
GEMINI_FAST_MODEL=gemini-flash-lite-latest

# Voice. "auto" picks the newest Gemini TTS model your key can use.
GEMINI_TTS_MODEL=auto

# Network: 127.0.0.1 = this computer only. 0.0.0.0 = also reachable from your phone on Wi-Fi / Tailscale.
HOST=0.0.0.0
PORT=8765

# Your IANA time zone, e.g. Europe/London, Asia/Jerusalem, America/New_York.
# Leave blank to use the computer's local time zone.
TIMEZONE=

# Optional HTTPS (needed for the phone microphone if you are NOT using Tailscale).
SSL_CERTFILE=
SSL_KEYFILE=
